APP_ENV=development
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENCRYPTION_KEY=replace-with-32-byte-secret

POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/smartshelf?sslmode=disable

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKETS=smartshelf-firmware,smartshelf-logs,smartshelf-archive

SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@smartshelf.ai
SEED_ADMIN_PASSWORD=ChangeMe123!
